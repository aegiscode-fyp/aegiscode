{
  "name": "@aegiscode/engine-dast",
  "version": "0.1.0",
  "private": true,
  "description": "AegisCode dynamic analysis engine (OWASP ZAP in Docker, targeted scan)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
