{
  "name": "@aegiscode/core",
  "version": "0.1.0",
  "private": true,
  "description": "AegisCode domain model, ScanEngine base class, ScanPipeline and shared utilities",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
